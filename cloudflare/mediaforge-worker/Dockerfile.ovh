FROM node:22-bookworm-slim

# Local Workerd TLS uses the OS/extra CA bundle, unlike Node.js's built-in
# root certificates. Twitch requests were failing on all Workerd HTTPS calls
# despite Node.js in this container receiving valid HTTP responses.
# Keep TLS verification ON; NEVER disable certificate verification for OAuth.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

WORKDIR /app

COPY package.json ./
RUN npm install --omit=optional

COPY . .

EXPOSE 8790

CMD ["npx","wrangler","dev","--local","--ip","0.0.0.0","--port","8790","--persist-to","/data","--config","wrangler.ovh.jsonc"]
